# PostgreSQL connection string.
# Postgres always runs in Docker (never installed on the host) — see the
# "Running in Docker" section of the README.
#   - local dev  (docker compose -f docker-compose.dev.yml up -d): use localhost
#   - full stack (docker compose up): the app container sets this itself to
#     point at the `db` service, so this file is not read.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bgv?schema=public"

# Secret used to sign session JWTs — set a long random value in production
AUTH_SECRET="change-me-to-a-long-random-string"

# KYC verification provider for Aadhar/PAN auto-checks.
# "mock" is the only one wired up out of the box (see src/lib/kyc).
KYC_PROVIDER="mock"

# Notification providers. "console" logs to stdout and still records every
# send in NotificationLog (see src/lib/notifications).
EMAIL_PROVIDER="console"
WHATSAPP_PROVIDER="console"

# Document storage provider. "local" writes to STORAGE_LOCAL_DIR on disk
# (see src/lib/storage).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"

# Bearer token required by POST /api/cron/reverification
CRON_SECRET="change-me-to-a-long-random-string"

# Extra origins allowed to submit Server Action forms (login, onboarding) when
# the app is served through a proxy or tunnel instead of localhost. Comma-
# separated; wildcards allowed (e.g. "app.example.com,**.trycloudflare.com").
# Common tunnels (*.devtunnels.ms, *.github.dev, ngrok, cloudflared) are already
# allowed by next.config.ts.
ALLOWED_ORIGINS=""
